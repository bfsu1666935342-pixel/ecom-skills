{
    "id":  "amazon-weekly-report",
    "title":  "亚马逊周报",
    "group":  "经营与报表",
    "order":  10,
    "tagline":  "本周所有 SPU 一张总览表 + 每个 SPU 的销量/利润/广告/关键词/竞品；能直接粘进飞书",
    "description":  "多 SPU 周报：总览（销量、销售额、周目标、达成率、目标/实际利润率、合计），然后每个 SPU 一段 A 整体 12 项周对比、B 广告（总览/每日/活动/关键词花费）、C 关键词（每个父体自然位/广告位/前 80%）、D 竞品（价格/评分/变体 + 前 80% 流量结构）。领星取经营，SIF 优先、Sorftime 兜底并标注估算；输出 HTML，点「复制到飞书」即可粘贴成文档。需要本机 Python 或终端。",
    "starters":  [
                     "出一份上周周报，美国站所有 SPU",
                     "66D50F 和 71B22A 上周销量和利润目标完成得怎么样",
                     "这个 SPU 有两个父体，关键词要分开看",
                     "把上周周报重新生成一份，粘到飞书",
                     "哪个 SPU 上周掉得最厉害，广告和关键词哪里拖后腿"
                 ],
    "fields":  [
                   {
                       "key":  "site",
                       "label":  "站点",
                       "type":  "text",
                       "placeholder":  "US / DE / GB / JP，默认 US",
                       "required":  true
                   },
                   {
                       "key":  "spu",
                       "label":  "SPU 清单",
                       "type":  "text",
                       "placeholder":  "多个用逗号分隔，例如 66D50F,71B22A；留空表示全部启用",
                       "required":  true
                   },
                   {
                       "key":  "parent_asin",
                       "label":  "父体 ASIN",
                       "type":  "text",
                       "placeholder":  "每个 SPU 的父体，多个用逗号分隔",
                       "required":  true
                   },
                   {
                       "key":  "competitor",
                       "label":  "对标竞品链接",
                       "type":  "text",
                       "placeholder":  "每个 SPU 一个 Amazon 链接或 ASIN",
                       "required":  true
                   },
                   {
                       "key":  "targets",
                       "label":  "月目标 / 目标利润率 / 成本",
                       "type":  "text",
                       "placeholder":  "从飞书文档复制：每个 SPU 的月销售额目标、目标利润率、采购/头程/FBA/佣金"
                   }
               ],
    "runOnly":  true,
    "commands":  [
                     {
                         "label":  "① 登记一个 SPU",
                         "run":  [
                                     "scripts\\run.cmd",
                                     "init",
                                     "--site",
                                     "{site}",
                                     "--spu",
                                     "{spu}",
                                     "--parent",
                                     "{parent}",
                                     "--competitor",
                                     "{competitor}"
                                 ],
                         "params":  [
                                        {
                                            "label":  "SPU 编码",
                                            "key":  "spu",
                                            "placeholder":  "例如 66D38",
                                            "required":  true
                                        },
                                        {
                                            "label":  "父体 ASIN",
                                            "key":  "parent",
                                            "placeholder":  "例如 B0FK5R58VT",
                                            "required":  true
                                        },
                                        {
                                            "label":  "站点",
                                            "key":  "site",
                                            "placeholder":  "默认 US"
                                        },
                                        {
                                            "label":  "竞品链接 / ASIN（可选）",
                                            "key":  "competitor",
                                            "placeholder":  "https://www.amazon.com/dp/..."
                                        }
                                    ],
                         "desc":  "把站点 / SPU / 父体 ASIN 记进去，竞品链接可选。有多个父体就同一个 SPU 再登记一次。",
                         "timeoutMs":  120000
                     },
                     {
                         "label":  "② 设置目标与成本",
                         "run":  [
                                     "scripts\\run.cmd",
                                     "targets",
                                     "--spu",
                                     "{spu}",
                                     "--monthly",
                                     "{monthly}",
                                     "--month",
                                     "{month}",
                                     "--margin",
                                     "{margin}",
                                     "--unit-cost",
                                     "{unit_cost}",
                                     "--first-leg",
                                     "{first_leg}",
                                     "--fba",
                                     "{fba}",
                                     "--referral",
                                     "{referral}",
                                     "--other",
                                     "{other}"
                                 ],
                         "params":  [
                                        {
                                            "label":  "SPU",
                                            "key":  "spu",
                                            "placeholder":  "例如 66D38",
                                            "required":  true
                                        },
                                        {
                                            "label":  "月销售目标",
                                            "key":  "monthly",
                                            "placeholder":  "430000"
                                        },
                                        {
                                            "label":  "目标月份",
                                            "key":  "month",
                                            "placeholder":  "2026-11，默认本月"
                                        },
                                        {
                                            "label":  "目标利润率",
                                            "key":  "margin",
                                            "placeholder":  "0.16"
                                        },
                                        {
                                            "label":  "单件采购成本",
                                            "key":  "unit_cost",
                                            "placeholder":  "17"
                                        },
                                        {
                                            "label":  "单件头程",
                                            "key":  "first_leg",
                                            "placeholder":  "3.8"
                                        },
                                        {
                                            "label":  "单件 FBA",
                                            "key":  "fba",
                                            "placeholder":  "7"
                                        },
                                        {
                                            "label":  "佣金费率",
                                            "key":  "referral",
                                            "placeholder":  "0.15"
                                        },
                                        {
                                            "label":  "单件其他成本",
                                            "key":  "other",
                                            "placeholder":  "1"
                                        }
                                    ],
                         "desc":  "月销售目标、目标利润率、成本项。只有填了的会改，留空的不动。",
                         "timeoutMs":  120000
                     },
                     {
                         "label":  "③ 查看已登记",
                         "run":  [
                                     "scripts\\run.cmd",
                                     "list"
                                 ],
                         "desc":  "列出当前 config/products.json 里所有 SPU 和父体，先确认数据对不对。",
                         "timeoutMs":  60000
                     },
                     {
                         "label":  "④ 生成本周周报",
                         "run":  [
                                     "scripts\\run.cmd",
                                     "run"
                                 ],
                         "desc":  "按已登记的 SPU 逐一出报告；结果复制到工作区「技能产出」。",
                         "timeoutMs":  900000
                     },
                     {
                         "label":  "⑤ 单跑一个 SPU",
                         "run":  [
                                     "scripts\\run.cmd",
                                     "run",
                                     "--product",
                                     "{spu}"
                                 ],
                         "params":  [
                                        {
                                            "label":  "SPU",
                                            "key":  "spu",
                                            "placeholder":  "例如 66D38",
                                            "required":  true
                                        }
                                    ],
                         "desc":  "只跑指定 SPU，适合先验证一个品通不通。",
                         "timeoutMs":  900000
                     },
                     {
                         "label":  "⑥ 检查数据源连通性",
                         "run":  [
                                     "scripts\\run.cmd",
                                     "doctor",
                                     "--provider",
                                     "lingxing"
                                 ],
                         "desc":  "不生成报告，只确认领星 MCP 能不能拿到数据。",
                         "timeoutMs":  120000
                     }
                 ],
    "configFiles":  [
                        "config/products.json",
                        "config/targets.json"
                    ]
}
